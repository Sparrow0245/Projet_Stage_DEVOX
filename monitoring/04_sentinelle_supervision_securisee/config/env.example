# ===============================================================
# Variables d'Environnement - Sentinelle V4
# Emplacement GitHub : monitoring/04_sentinelle_supervision_securisee/config/env.example
# Destination VM    : /var/www/html/sentinelle/config/.env
# ===============================================================

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sentinelle
DB_USER=sentinelle
DB_PASS=SentinelleSecurePass2026!

# Paramètres Application Web
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/sentinelle

# Sécurité & Session
SESSION_LIFETIME=3600
SECURE_COOKIES=true
