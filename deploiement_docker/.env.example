# ============================================================
# Sentinelle Docker - Configuration
# Copier ce fichier vers .env avant le premier lancement.
# ============================================================

# Mode BDD :
# local    = MariaDB déployée automatiquement par Docker Compose
# external = MySQL/MariaDB déjà présente ailleurs
DB_MODE=local

DB_HOST=db
DB_PORT=3306
DB_NAME=sentinelle
DB_USER=sentinelle
DB_PASS=CHANGE_ME
DB_ROOT_PASS=CHANGE_ME_ROOT

# Port HTTP public du dashboard
HTTP_PORT=8080

# Port local du backend Spring Boot
BACKEND_PORT=8081

# Identifiant logique de l'hôte surveillé
HOST_ID=1

# Services systemd de l'hôte à surveiller
# Adapter cette liste au serveur cible.
MONITORED_SERVICES=ssh

# Seuils de supervision
CPU_WARNING=80
CPU_CRITICAL=95

RAM_WARNING=85
RAM_CRITICAL=95

DISK_WARNING=85
DISK_CRITICAL=90

SWAP_WARNING=50

# Intervalle de collecte
COLLECTION_INTERVAL=2

# Journalisation
LOG_LEVEL=INFO

# JWT
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRATION=28800
